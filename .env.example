# QiyiqDoʻppi configuration. Copy to `.env` and fill in; never commit `.env`.
# Empty values mean "use the default". Secrets are marked [secret].

# ---------------------------------------------------------------- core
# PostgreSQL connection string. [secret] (contains the password)
DATABASE_URL=postgres://qiyiq:CHANGE_ME@localhost:5432/qiyiq
# Public address of the site, no trailing slash. Used in QR codes, admin
# alerts and share links. https here also turns on Secure cookies and HSTS.
PUBLIC_BASE_URL=http://localhost:8080
# Address and port the server listens on.
BIND_ADDR=0.0.0.0:8080
# Shown in the app and on production sheets.
BRAND_NAME=QiyiqDoʻppi
# Folder with the built web app (scripts/build-web.sh output).
STATIC_DIR=./crates/web/dist
# Max database connections.
DB_MAX_CONNECTIONS=10
# Background worker count (rendering, notifications, try-on).
WORKERS=2
# json (default, for production) or pretty (for a terminal).
LOG_FORMAT=json
# Log level filter, e.g. info or server=debug,info.
RUST_LOG=info

# ------------------------------------------------- production compose only
# Used by deploy/docker-compose.prod.yml, not by the server itself.
# Database password for the bundled Postgres. [secret]
POSTGRES_PASSWORD=
# Image to run, pushed by the deploy workflow, e.g. ghcr.io/owner/repo:1.0.0
APP_IMAGE=
# Domain Caddy serves and gets a certificate for, e.g. qiyiqdoppi.uz
SITE_DOMAIN=

# --------------------------------------------------------------- admin
# Creates (or resets the password of) the admin account at startup.
# Password must be at least 10 characters. [secret]
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# How long an admin stays signed in.
SESSION_TTL_HOURS=12
# Force the Secure flag on the session cookie (default: on when
# PUBLIC_BASE_URL is https).
COOKIE_SECURE=
# Language of admin alerts and production sheets: uz, ru or en.
ADMIN_LANG=uz

# ------------------------------------------------------------- security
# Set to true only when the server sits behind your own reverse proxy
# (the production compose file sets it). Makes rate limiting use the
# client address from X-Forwarded-For.
TRUST_PROXY=false
# Other origins allowed to call the API: the mobile apps' WebView origins.
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# Largest accepted upload in MB (1-50).
MAX_UPLOAD_MB=10
# Allow ordering foil finishes (v2 feature; keep false).
ALLOW_FOIL=false
# Delete unordered designs and unused uploads after this many days.
DRAFT_TTL_DAYS=90

# -------------------------------------------------------------- storage
# s3 (MinIO, Cloudflare R2, any S3-compatible), fs (a local folder) or
# memory (tests only; lost on restart).
STORAGE_BACKEND=fs
# Folder for STORAGE_BACKEND=fs.
STORAGE_FS_DIR=./data/storage
# For STORAGE_BACKEND=s3. R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# [secret]
S3_ACCESS_KEY=
# [secret]
S3_SECRET_KEY=
# true for MinIO (path-style URLs); false for virtual-hosted buckets.
S3_PATH_STYLE=true

# --------------------------------------------------------- photo try-on
# mock (default, free, works offline) or fashn (real, paid per image).
TRYON_PROVIDER=mock
# FASHN API key, from https://app.fashn.ai/api [secret]
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai
# performance, balanced or quality.
FASHN_MODE=balanced
# What one generated image costs you, in soʻm (for the daily cap).
# FASHN charges $0.075; convert at your current rate.
TRYON_COST_PER_IMAGE_SUM=1000
# Stop generating for the day once this much has been spent, in soʻm.
TRYON_DAILY_COST_CAP_SUM=200000
# Photos and results are deleted after this many hours.
TRYON_TTL_HOURS=24
# Generations per device per 24 hours.
TRYON_PER_DEVICE_DAILY=5
# Generations per day across all customers.
TRYON_GLOBAL_DAILY=300
# Give up on one generation after this many seconds.
TRYON_TIMEOUT_SECS=120

# ----------------------------------------------------------- moderation
# The image moderator is a mock in v1. allow_all (default) or flag_all
# (sends every design with an image to manual review).
MODERATION_MOCK_MODE=allow_all
# Comma-separated SHA-256 hashes of images the mock should flag.
MODERATION_MOCK_FLAG_SHA256=

# ------------------------------------------------------------- telegram
# Bot token from @BotFather. Leave empty to run without a bot: alerts are
# then only written to the log. [secret]
TELEGRAM_BOT_TOKEN=
# Bot username without @, used for links in the app.
TELEGRAM_BOT_USERNAME=
# Chat that receives new-order alerts (your own chat id or a group id).
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------ demo
# true creates one example order on an empty database.
SEED_DEMO=false
