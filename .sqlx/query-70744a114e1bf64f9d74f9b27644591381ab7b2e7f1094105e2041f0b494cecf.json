  "query": "SELECT id, device_id, photo_key, garment_key, result_key, result_mime, provider, status, error, cache_key, expires_at\n         FROM tryon_jobs\n         WHERE cache_key = $1 AND device_id = $2 AND status = 'done' AND expires_at > now()\n         ORDER BY created_at DESC LIMIT 1",
